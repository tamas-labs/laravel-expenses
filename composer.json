{
    "name": "tamas-labs/laravel-expenses",
    "description": "Laravel sync backend for the Expenses app, built on the tamas-labs/expenses-schema contract.",
    "keywords": [
        "laravel",
        "expenses",
        "sync",
        "json-schema"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Tamas Labs",
            "email": "tbalint78@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tamas-labs/expenses-schema"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/sanctum": "^4.3.1",
        "opis/json-schema": "^2.6",
        "tamas-labs/expenses-schema": "^1.0.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.2",
        "orchestra/workbench": "^11.2",
        "pestphp/pest": "^4.7 || ^5.2",
        "pestphp/pest-plugin-laravel": "^4.1 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "TamasLabs\\LaravelExpenses\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TamasLabs\\LaravelExpenses\\Database\\Factories\\": "database/factories/",
            "TamasLabs\\LaravelExpenses\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TamasLabs\\LaravelExpenses\\ExpensesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --exclude-group=performance",
        "test:performance": "pest --group=performance",
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=1G"
        ],
        "format": "pint",
        "format:check": "pint --test",
        "quality": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "dev:seed": [
            "@php vendor/bin/testbench migrate --force",
            "@php vendor/bin/testbench db:seed --class=\"Workbench\\\\Database\\\\Seeders\\\\DatabaseSeeder\" --force"
        ],
        "dev:serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --host=0.0.0.0 --port=8080"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
